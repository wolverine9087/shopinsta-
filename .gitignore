```gitignore
# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
frontend/.env
backend/.env

# Build files
dist/
build/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Cache
.cache/
.vite/
.eslintcache/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/

# Testing
.nyc_output/

# Local databases and uploads
*.sqlite
*.sqlite3
uploads/
```
