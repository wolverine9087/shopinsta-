# Backend server
NODE_ENV=development
PORT=5000

# Frontend origin used by credentialed CORS requests
CLIENT_URL=http://localhost:5173

# MongoDB connection (required to start the backend)
MONGO_URI=mongodb://127.0.0.1:27017/shopinsta

# JWT signing key (use a long, random secret outside local development)
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary credentials (required for product/reel image and video uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
